# ==========================================
# AI Life OS - Root .gitignore
# ==========================================

# ------------------------------------------
# General / OS
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log

# ------------------------------------------
# Credentials & Environment Variables
# ------------------------------------------
# CAUTION: Never commit real environment variables or credentials!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example
.env.local.example
*.env*
credentials.json
*.pem
*.key
*.cert

# Allow example env files
# User requested NO env files of any kind to be committed
# !.env.example
# !.env.local.example

# ------------------------------------------
# Backend (Python / FastAPI)
# ------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# Local databases and vector stores
backend/data/
*.sqlite3
*.db
chroma.sqlite3

# ------------------------------------------
# Frontend (Node / Next.js)
# ------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js build output
.next/
out/
build/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------
# Artifacts & Caches
# ------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache
